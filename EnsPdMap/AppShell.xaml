<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="EnsPdMap.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:EnsPdMap.Pages"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />
    <ShellContent Route="inscription" ContentTemplate="{DataTemplate pages:InscriptionPage}" />
    <ShellContent Route="accueil" ContentTemplate="{DataTemplate pages:AccueilPage}" />
    <ShellContent Route="plan" ContentTemplate="{DataTemplate pages:PlanPage}" />
    <ShellContent Route="annuaire" ContentTemplate="{DataTemplate pages:AnnuairePage}" />
    <ShellContent Route="horsligne" ContentTemplate="{DataTemplate pages:HorsLignePage}" />

</Shell>
