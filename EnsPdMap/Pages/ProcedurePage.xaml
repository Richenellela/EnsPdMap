<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EnsPdMap.Controls"
             x:Class="EnsPdMap.Pages.ProcedurePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="0">

                <!-- Barre du haut -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26"
                            Stroke="{StaticResource Line}" StrokeThickness="1.5" BackgroundColor="White">
                        <c:Icon Glyph="back" IconColor="{StaticResource Ink}" Size="22" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBack" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="2" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26"
                            Stroke="{StaticResource Line}" StrokeThickness="1.5" BackgroundColor="White">
                        <c:Icon Glyph="share" IconColor="{StaticResource Ink}" Size="22" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShare" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="BookmarkBtn" Grid.Column="3" WidthRequest="52" HeightRequest="52"
                            StrokeShape="RoundRectangle 26" StrokeThickness="0" BackgroundColor="{StaticResource Navy}">
                        <c:Icon x:Name="BookmarkIcon" Glyph="bookmark" IconColor="{StaticResource Gold}" Size="22" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBookmark" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Label x:Name="CatLabel" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource GoldDark}"
                       Margin="0,10,0,2" />
                <Label x:Name="TitleLabel" FontSize="30" FontAttributes="Bold" />

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,18,0,0" />
                <Grid ColumnDefinitions="*,1,*,1,*" Padding="0,14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Délai" FontSize="14" TextColor="{StaticResource Muted}" />
                        <Label x:Name="DelayLabel" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" WidthRequest="1" Color="{StaticResource Line}" />
                    <VerticalStackLayout Grid.Column="2" Spacing="2" Padding="16,0,0,0">
                        <Label Text="Coût" FontSize="14" TextColor="{StaticResource Muted}" />
                        <Label x:Name="CostLabel" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="3" WidthRequest="1" Color="{StaticResource Line}" />
                    <VerticalStackLayout Grid.Column="4" Spacing="2" Padding="16,0,0,0">
                        <Label Text="Bureau" FontSize="14" TextColor="{StaticResource Muted}" />
                        <Label x:Name="OfficeLabel" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                <!-- Formulaire -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,0" HeightRequest="60">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <c:Icon Glyph="download" IconColor="{StaticResource Ink}" Size="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Formulaire PDF compact" FontSize="16" FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label x:Name="FormSizeLabel" Grid.Column="2" FontSize="14" TextColor="{StaticResource Muted}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDownload" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Pièces à fournir -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,22,0,0">
                    <Label Text="Pièces à fournir" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="ReadyLabel" Grid.Column="1" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource Green}" VerticalOptions="Center" />
                </Grid>
                <c:Bar x:Name="ReadyBar" FillColor="{StaticResource Green}" TrackColor="{StaticResource Line}"
                       Margin="0,10,0,6" />
                <VerticalStackLayout x:Name="PiecesList" Spacing="0" />

                <!-- Parcours -->
                <Label Text="Parcours séquentiel" FontSize="20" FontAttributes="Bold" Margin="0,22,0,12" />
                <VerticalStackLayout x:Name="StepsList" Spacing="0" />

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 0" Padding="20,12,20,14">
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                    HeightRequest="58">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <c:Icon Glyph="nav" IconColor="White" Size="20" VerticalOptions="Center" />
                    <Label x:Name="LocateLabel" TextColor="White" FontAttributes="Bold" FontSize="17"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLocate" />
                </Border.GestureRecognizers>
            </Border>
        </Border>
    </Grid>
</ContentPage>
