<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EnsPdMap.Controls"
             x:Class="EnsPdMap.Pages.BureauPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid>
        <!-- Mini-plan en haut -->
        <Grid VerticalOptions="Start" HeightRequest="230" BackgroundColor="{StaticResource MapBg}" IsClippedToBounds="True">
            <AbsoluteLayout>
                <Border AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.05,0.0,0.36,0.85"
                        StrokeShape="RoundRectangle 10" Stroke="{StaticResource BlockLine}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Line}" />
                <Border AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.85,0.0,0.42,0.55"
                        StrokeShape="RoundRectangle 10" Stroke="{StaticResource BlockLine}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Line}" />
                <Border AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.70,1.0,0.25,0.3"
                        StrokeShape="RoundRectangle 10" Stroke="{StaticResource BlockLine}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Line}" />
                <Border AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.98,1.0,0.17,0.3"
                        StrokeShape="RoundRectangle 10" Stroke="{StaticResource BlockLine}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Line}" />
            </AbsoluteLayout>
        </Grid>

        <ScrollView Margin="0,185,0,0">
            <Border BackgroundColor="{StaticResource Bg}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0"
                    Padding="22,22,22,28">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="TitleLabel" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border x:Name="StatusBadge" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                Padding="14,6" VerticalOptions="Center">
                            <Label x:Name="StatusLabel" FontSize="14" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                        <c:Icon Glyph="pin" IconColor="{StaticResource Muted}" Size="20" VerticalOptions="Center" />
                        <Label x:Name="PlaceLabel" FontSize="16" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label x:Name="LandmarkLabel" FontSize="14" TextColor="{StaticResource Muted}" Margin="0,4,0,0" />

                    <Border x:Name="QueueBox" BackgroundColor="{StaticResource Sand}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14" Padding="16,14" Margin="0,16,0,0">
                        <HorizontalStackLayout Spacing="10">
                            <c:Icon Glyph="users" IconColor="{StaticResource GoldDark}" Size="22" VerticalOptions="Center" />
                            <Label x:Name="QueueLabel" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource GoldDark}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Affluence signalée par les étudiants -->
                    <Border x:Name="CrowdCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Affluence en ce moment" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Vous êtes sur place ? Signalez l'affluence que vous voyez pour aider les autres étudiants."
                                   FontSize="13" TextColor="{StaticResource Muted}" />
                            <HorizontalStackLayout x:Name="CrowdButtons" Spacing="8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,16,0,0">
                        <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                HeightRequest="84">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Icon Glyph="phone" IconColor="White" Size="24" />
                                <Label Text="Appeler" TextColor="White" FontSize="15" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCall" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="White" Stroke="{StaticResource Navy}" StrokeThickness="2"
                                StrokeShape="RoundRectangle 16" HeightRequest="84">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Icon Glyph="mail" IconColor="{StaticResource Navy}" Size="24" />
                                <Label Text="E-mail" TextColor="{StaticResource Navy}" FontSize="15" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMail" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="White" Stroke="{StaticResource Navy}" StrokeThickness="2"
                                StrokeShape="RoundRectangle 16" HeightRequest="84">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Icon Glyph="nav" IconColor="{StaticResource Navy}" Size="24" />
                                <Label Text="Itinéraire" TextColor="{StaticResource Navy}" FontSize="15" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRoute" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Horaires -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,10">
                        <Label Text="Horaires" FontSize="22" FontAttributes="Bold" />
                        <Label x:Name="ClosesLabel" Grid.Column="1" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout x:Name="HoursList" Spacing="4" />

                    <!-- Contacts -->
                    <Label Text="Contacts" FontSize="22" FontAttributes="Bold" Margin="0,26,0,6" />
                    <VerticalStackLayout x:Name="ContactList" Spacing="0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Bouton retour -->
        <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26"
                BackgroundColor="White" Stroke="{StaticResource Line}" StrokeThickness="1.5" HorizontalOptions="Start" VerticalOptions="Start" Margin="16,16,0,0">
            <c:Icon Glyph="back" IconColor="{StaticResource Ink}" Size="22" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBack" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
