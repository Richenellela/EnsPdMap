<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EnsPdMap.Controls"
             x:Class="EnsPdMap.Pages.InscriptionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="22,16,22,28" Spacing="0">

            <!-- Barre du haut -->
            <Grid ColumnDefinitions="Auto,*">
                <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26"
                        Stroke="{StaticResource Line}" StrokeThickness="1.5" BackgroundColor="White">
                    <c:Icon Glyph="back" IconColor="{StaticResource Ink}" Size="22" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBack" />
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1" Text="J'ai un compte" FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Navy}" HorizontalOptions="End" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBack" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Progression -->
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" Margin="0,16,0,0">
                <BoxView HeightRequest="6" CornerRadius="3" Color="{StaticResource Navy}" VerticalOptions="Center" />
                <BoxView Grid.Column="1" HeightRequest="6" CornerRadius="3" Color="{StaticResource Navy}"
                         VerticalOptions="Center" />
                <Label Grid.Column="2" Text="Étape 2 / 2" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Muted}" />
            </Grid>

            <Label Text="Profil académique" FontSize="32" FontAttributes="Bold" Margin="0,26,0,0" />
            <Label Text="Réservé aux étudiants inscrits à l'ENSPD." FontSize="15"
                   TextColor="{StaticResource Muted}" Margin="0,6,0,22" />

            <!-- Nom complet -->
            <Label Text="Nom complet" FontSize="15" FontAttributes="Bold" Margin="0,0,0,8" />
            <Border x:Name="NameBox" Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="NameEntry" Placeholder="NOM Prénom" TextChanged="OnNameChanged"
                           VerticalOptions="Center" />
                    <c:Icon x:Name="NameIcon" Grid.Column="1" Glyph="ok" Size="26" IsVisible="False" />
                </Grid>
            </Border>

            <!-- Matricule -->
            <Label Text="Matricule" FontSize="15" FontAttributes="Bold" Margin="0,18,0,8" />
            <Border x:Name="MatBox" Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="MatEntry" Placeholder="Ex. 24G01622" TextChanged="OnMatChanged"
                           VerticalOptions="Center" />
                    <c:Icon x:Name="MatIcon" Grid.Column="1" Glyph="ok" Size="26" IsVisible="False" />
                </Grid>
            </Border>
            <Label x:Name="MatHint" Text="Format attendu : 24G01622" FontSize="13"
                   TextColor="{StaticResource Muted}" Margin="0,6,0,0" />

            <!-- Filière -->
            <Label Text="Filière" FontSize="15" FontAttributes="Bold" Margin="0,18,0,10" />
            <FlexLayout x:Name="FilFlex" Wrap="Wrap" />

            <!-- Niveau -->
            <Label Text="Niveau" FontSize="15" FontAttributes="Bold" Margin="0,8,0,10" />
            <FlexLayout x:Name="NivFlex" Wrap="Wrap" />

            <!-- E-mail institutionnel -->
            <Label x:Name="MailLabel" Text="E-mail institutionnel" FontSize="15" FontAttributes="Bold"
                   Margin="0,8,0,8" />
            <Border x:Name="MailBox" Style="{StaticResource FieldBox}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="MailEntry" Placeholder="prenom.nom@univ-douala.cm" Keyboard="Email"
                           TextChanged="OnMailChanged" VerticalOptions="Center" />
                    <c:Icon x:Name="MailIcon" Grid.Column="1" Glyph="alert" Size="26" IsVisible="False" />
                </Grid>
            </Border>
            <Label x:Name="MailHint" Text="Utilisez une adresse @univ-douala.cm" FontSize="13"
                   TextColor="{StaticResource Red}" Margin="0,6,0,0" IsVisible="False" />

            <!-- Mot de passe -->
            <Label Text="Mot de passe" FontSize="15" FontAttributes="Bold" Margin="0,18,0,8" />
            <Border Style="{StaticResource FieldBox}" Stroke="{StaticResource Ink}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PwdEntry" Placeholder="8 caractères minimum" IsPassword="True"
                           TextChanged="OnPwdChanged" VerticalOptions="Center" />
                    <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40">
                        <c:Icon x:Name="EyeIcon" Glyph="eye" IconColor="{StaticResource Muted}" Size="22" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleEye" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                <BoxView x:Name="S1" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line}" VerticalOptions="Center" />
                <BoxView x:Name="S2" Grid.Column="1" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line}" VerticalOptions="Center" />
                <BoxView x:Name="S3" Grid.Column="2" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line}" VerticalOptions="Center" />
                <BoxView x:Name="S4" Grid.Column="3" HeightRequest="6" CornerRadius="3" Color="{StaticResource Line}" VerticalOptions="Center" />
                <Label x:Name="StrengthLabel" Grid.Column="4" Text="" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource GoldDark}" WidthRequest="60" HorizontalTextAlignment="End" />
            </Grid>

            <!-- Charte -->
            <HorizontalStackLayout Spacing="8" Margin="0,18,0,0">
                <CheckBox x:Name="CharteCheck" Color="{StaticResource Navy}" VerticalOptions="Start" />
                <Label Text="J'accepte la charte informatique et le traitement de mes données." FontSize="15"
                       WidthRequest="290" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="{StaticResource Red}" FontSize="13" IsVisible="False"
                   Margin="0,10,0,0" />

            <Button x:Name="SubmitButton" Text="Créer mon compte" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                    Clicked="OnSubmit" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
