<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EnsPdMap.Controls"
             x:Class="EnsPdMap.Pages.PlanPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource MapBg}">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" IsClippedToBounds="True">

            <!-- Carte -->
            <Grid x:Name="MapHost" IsClippedToBounds="True" BackgroundColor="{StaticResource MapBg}">
                <AbsoluteLayout x:Name="MapLayer" />
            </Grid>

            <!-- Recherche + étages -->
            <VerticalStackLayout VerticalOptions="Start" Margin="16,14,16,0" Spacing="12">
                <Border Style="{StaticResource FieldBox}" HeightRequest="54" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.18" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <c:Icon Glyph="search" IconColor="{StaticResource Ink}" Size="22" VerticalOptions="Center" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher un bureau"
                               ReturnType="Search" Completed="OnSearch" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <HorizontalStackLayout x:Name="FloorChips" Spacing="10" />
            </VerticalStackLayout>

            <!-- Zoom -->
            <Border HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,60" WidthRequest="54"
                    StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="10" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="54">
                        <c:Icon Glyph="plus" IconColor="{StaticResource Ink}" Size="22" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomIn" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid HeightRequest="54">
                        <c:Icon Glyph="minus" IconColor="{StaticResource Ink}" Size="22" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomOut" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid HeightRequest="54">
                        <c:Icon Glyph="locate" IconColor="{StaticResource Navy}" Size="22" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLocate" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Fiche en bas : à tirer vers le haut pour voir le détail -->
            <Border x:Name="Sheet" VerticalOptions="End" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 28,28,0,0" Padding="22,0,22,18" TranslationY="230">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="14" Offset="0,-3" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSheetPan" />
                    <SwipeGestureRecognizer Direction="Up" Swiped="OnSheetSwipe" />
                    <SwipeGestureRecognizer Direction="Down" Swiped="OnSheetSwipe" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">

                    <Grid HeightRequest="34">
                        <BoxView WidthRequest="44" HeightRequest="5" CornerRadius="3" Color="{StaticResource Line}"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                        <c:Icon x:Name="SheetChevron" Glyph="chevron" IconColor="{StaticResource Muted}" Size="18"
                                HorizontalOptions="End" VerticalOptions="Center" Rotation="-90" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetHandle" />
                            <PanGestureRecognizer PanUpdated="OnSheetPan" />
                            <SwipeGestureRecognizer Direction="Up" Swiped="OnSheetSwipe" />
                            <SwipeGestureRecognizer Direction="Down" Swiped="OnSheetSwipe" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="SheetTitle" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border x:Name="StatusBadge" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                Padding="14,6" VerticalOptions="Center">
                            <Label x:Name="StatusLabel" FontSize="14" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Label x:Name="SheetSub" FontSize="16" TextColor="{StaticResource Muted}" Margin="0,6,0,0" />
                    <Label x:Name="SheetDistance" FontSize="15" Margin="0,14,0,0" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                        <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                HeightRequest="56">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Icon Glyph="nav" IconColor="White" Size="20" VerticalOptions="Center" />
                                <Label Text="Itinéraire" TextColor="White" FontAttributes="Bold" FontSize="17"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRoute" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="White" Stroke="{StaticResource Navy}"
                                StrokeThickness="2" StrokeShape="RoundRectangle 16" HeightRequest="56">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <c:Icon Glyph="building" IconColor="{StaticResource Navy}" Size="20" VerticalOptions="Center" />
                                <Label Text="Fiche" TextColor="{StaticResource Navy}" FontAttributes="Bold" FontSize="17"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSheet" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Détail révélé en tirant la fiche -->
                    <VerticalStackLayout x:Name="ExtraBox" Spacing="0" Margin="0,18,0,0">
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Border x:Name="SheetQueueBox" BackgroundColor="{StaticResource Sand}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,14,0,0">
                            <HorizontalStackLayout Spacing="10">
                                <c:Icon Glyph="users" IconColor="{StaticResource GoldDark}" Size="20" VerticalOptions="Center" />
                                <Label x:Name="SheetQueue" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource GoldDark}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,14,0,0">
                            <Label Text="Horaires (lun – jeu)" FontSize="14" TextColor="{StaticResource Muted}" />
                            <Label x:Name="SheetHours" Grid.Column="1" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,10,0,0">
                            <Label Text="Téléphone" FontSize="14" TextColor="{StaticResource Muted}" />
                            <Label x:Name="SheetPhone" Grid.Column="1" FontSize="15" FontAttributes="Bold"
                                   HorizontalOptions="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,10,0,0">
                            <Label Text="E-mail" FontSize="14" TextColor="{StaticResource Muted}" />
                            <Label x:Name="SheetMail" Grid.Column="1" FontSize="14" FontAttributes="Bold"
                                   HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <c:BottomNav Grid.Row="1" Active="plan" />
    </Grid>
</ContentPage>
