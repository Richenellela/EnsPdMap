<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:EnsPdMap.Controls"
             x:Class="EnsPdMap.Pages.EtalonnagePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="22,16,22,28" Spacing="0">

            <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26" HorizontalOptions="Start"
                    Stroke="{StaticResource Line}" StrokeThickness="1.5" BackgroundColor="White">
                <c:Icon Glyph="back" IconColor="{StaticResource Ink}" Size="22" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
            </Border>

            <Label Text="Étalonner le plan" FontSize="30" FontAttributes="Bold" Margin="0,18,0,6" />
            <Label Text="Le plan du campus est schématique. Pour que le point bleu vous place au bon endroit et que l'itinéraire parte de votre position, il faut le caler une fois sur le terrain, avec le GPS de ce téléphone."
                   FontSize="15" TextColor="{StaticResource Muted}" />

            <!-- GPS en direct -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <HorizontalStackLayout Spacing="10">
                    <c:Icon Glyph="pin" IconColor="{StaticResource Navy}" Size="22" VerticalOptions="Center" />
                    <Label x:Name="GpsInfo" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"
                           MaximumWidthRequest="300" />
                </HorizontalStackLayout>
            </Border>

            <!-- Étape 1 -->
            <Label Text="1. À l'entrée principale" FontSize="20" FontAttributes="Bold" Margin="0,24,0,6" />
            <Label Text="Placez-vous à l'entrée principale du campus (le point « Entrée » du plan), attendez que la précision passe sous 15 m, puis touchez le bouton."
                   FontSize="14" TextColor="{StaticResource Muted}" />
            <Button Text="Je suis à l'entrée principale" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                    Clicked="OnAnchor1" />

            <!-- Étape 2 -->
            <Label Text="2. Devant le Bloc A (facultatif)" FontSize="20" FontAttributes="Bold" Margin="0,24,0,6" />
            <Label Text="Marchez jusqu'à la porte du Bloc A (au moins 15 m de l'entrée) puis touchez le bouton : cela règle l'orientation et l'échelle du plan."
                   FontSize="14" TextColor="{StaticResource Muted}" />
            <Button Text="Je suis devant le Bloc A" BackgroundColor="White" TextColor="{StaticResource Navy}"
                    BorderColor="{StaticResource Navy}" BorderWidth="2" CornerRadius="16" HeightRequest="58"
                    FontAttributes="Bold" FontSize="17" Margin="0,12,0,0" Clicked="OnAnchor2" />

            <!-- État -->
            <Border x:Name="StatusBox" BackgroundColor="{StaticResource Sand}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14" Padding="16,14" Margin="0,22,0,0">
                <Label x:Name="CalStatus" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource GoldDark}" />
            </Border>

            <Button Text="Partager l'étalonnage avec les autres étudiants" BackgroundColor="Transparent"
                    TextColor="{StaticResource Navy}" FontAttributes="Bold" FontSize="15" Margin="0,10,0,0"
                    Clicked="OnShare" />
            <Button Text="Réinitialiser" BackgroundColor="Transparent" TextColor="{StaticResource Red}"
                    FontAttributes="Bold" FontSize="15" Clicked="OnReset" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
